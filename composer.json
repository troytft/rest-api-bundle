{
    "name": "troytft/rest-api-bundle",
    "type": "library",
    "description": "REST API Bundle is abstraction layer for requests and responses",
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "RestApiBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/src"
        }
    },
    "config": {
        "platform": {
            "php": "8.4"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "devizzent/cebe-php-openapi": "^1.0",
        "doctrine/doctrine-bundle": "^2.4",
        "doctrine/orm": "^2.9",
        "phpdocumentor/reflection-docblock": "^5.4|^6.4",
        "symfony/cache": "^6.4|^7.0",
        "symfony/console": "^6.4|^7.0",
        "symfony/expression-language": "^6.4|^7.0",
        "symfony/filesystem": "^6.4|^7.0",
        "symfony/finder": "^6.4|^7.0",
        "symfony/framework-bundle": "^6.4|^7.0",
        "symfony/http-kernel": "^6.4|^7.0",
        "symfony/property-info": "^6.4|^7.0",
        "symfony/routing": "^6.4|^7.0",
        "symfony/serializer": "^6.4|^7.0",
        "symfony/translation": "^6.4|^7.0",
        "symfony/validator": "^6.4|^7.0",
        "symfony/yaml": "^6.4|^7.0"
    },
    "bin": ["bin/generate-docs"],
    "require-dev": {
        "nyholm/symfony-bundle-test": "^3.0",
        "phpbench/phpbench": "^1.0.4",
        "phpstan/phpstan": "~2.2.2",
        "phpunit/phpunit": "~10.5.46",
        "spatie/phpunit-snapshot-assertions": "~5.2.0",
        "symplify/easy-coding-standard": "^12.5.20"
    }
}
